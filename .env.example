# Frontend-only API configuration.
# The browser calls these endpoints directly. No Next.js API/server routes are required.
NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
NEXT_PUBLIC_MARKET_API_URL=https://your-market-api.example.com
NEXT_PUBLIC_WEATHER_API_URL=https://your-weather-api.example.com
NEXT_PUBLIC_MAPS_API_KEY=your_public_maps_key
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Set to false when your real backend is ready and you want API failures surfaced in the UI.
NEXT_PUBLIC_USE_MOCK_FALLBACK=true
